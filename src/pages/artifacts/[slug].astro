    <a href="/inbox/"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 6.5h16v11H4z"/><path d="M4 13h4l1.5 2h5L16 13h4"/></svg>Inbox</a>
    <a href="/artifacts/" aria-current="page"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4"/></svg>Artifacts</a>
