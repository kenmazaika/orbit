---
import '@fontsource-variable/literata';
import '@fontsource-variable/inter';
import '../styles/global.css';

interface Props { title: string; description?: string; page?: 'home' | 'archive' | 'saved' | 'article' | 'report' | 'plain'; }
const { title, description = 'A quiet stream of things worth reading.', page = 'plain' } = Astro.props;
const path = Astro.url.pathname;
const on = (p: string) => (p === '/' ? path === '/' : path.startsWith(p));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="theme-color" content="#FCF9F7" />
    <title>{title === 'Orbit' ? 'Orbit' : `${title} · Orbit`}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body data-page={page}>
    <header class="masthead">
      <div class="masthead-in">
        <a class="brand" href="/" aria-label="Orbit home">
          <svg class="brand-mark" viewBox="0 0 34 24" fill="none" aria-hidden="true">
            <ellipse cx="17" cy="12" rx="15" ry="6.4" stroke="#6D35C5" stroke-width="1.5" transform="rotate(-18 17 12)" />
            <ellipse cx="17" cy="12" rx="10.5" ry="10" stroke="#72D7B8" stroke-width="1.3" />
            <path d="M4 15.5c5-4 8-2 10 .5" stroke="#5C8FE0" stroke-width="1.3" stroke-linecap="round" />
            <circle cx="17" cy="12" r="2.4" fill="#171619" />
          </svg>
          <span class="brand-word">Orbit</span>
        </a>

        <nav class="masthead-nav" aria-label="Sections">
          <a href="/" aria-current={on('/') ? 'page' : undefined}>Feed</a>
          <a href="/inbox/" aria-current={on('/inbox') ? 'page' : undefined}>Inbox</a>
          <a href="/artifacts/" aria-current={on('/artifacts') ? 'page' : undefined}>Artifacts</a>
          <a href="/report/" aria-current={on('/report') ? 'page' : undefined}>Report</a>
          <a href="/archive/" aria-current={on('/archive') ? 'page' : undefined}>Archive</a>
          <a href="/saved/" aria-current={on('/saved') ? 'page' : undefined}>Saved</a>
          <form method="post" action="/__orbit/logout"><button type="submit">Lock</button></form>
        </nav>

        <span class="private-pill">Private</span>
      </div>
    </header>

    <main><slot /></main>

    <nav class="dock" aria-label="Orbit">
      <div class="dock-in">
        <a href="/" aria-current={on('/') ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-4.5v-6h-5v6H5a1 1 0 0 1-1-1z"/></svg>
          Feed
        </a>
        <a href="/inbox/" aria-current={on('/inbox') ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 6.5h16v11a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 17.5z"/><path d="M4 13h4l1.5 2h5L16 13h4"/></svg>
          Inbox
        </a>
        <a href="/artifacts/" aria-current={on('/artifacts') ? 'page' : undefined}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4"/></svg>
          Artifacts
        </a>
        <form method="post" action="/__orbit/logout">
          <button type="submit">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="4.5" y="10.5" width="15" height="9.5" rx="2"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/></svg>
            Lock
          </button>
        </form>
      </div>
    </nav>
  </body>
</html>

<style>
  .masthead-nav button {
    all: unset; cursor: pointer; font: inherit; color: inherit;
  }
  .dock form { display: flex; flex: 1; }
  .dock button {
    all: unset; cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 4px;
    font-family: inherit; font-size: .72rem; line-height: inherit; color: #343137;
    width: 100%; padding: 4px 0 2px;
  }
</style>
