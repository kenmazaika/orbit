{
  "name": "orbit",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test:objects": "node --test tests/objects/*.test.mjs",
    "dev:react": "node scripts/build-react-content.mjs && npm --prefix react run dev",
    "build:staging": "node scripts/build-react-content.mjs && npm --prefix react run build && node scripts/bundle-staging-assets.mjs",
    "migrate:staging": "bash scripts/migrate-staging.sh",
    "seed:staging": "bash scripts/seed-staging.sh",
    "test:staging": "node scripts/smoke-staging.mjs",
    "simulate:staging": "node scripts/staging-simulator.mjs",
    "build:react-prod": "node scripts/build-react-content.mjs && npm --prefix react run build && node scripts/bundle-react-prod-assets.mjs",
    "build:selfhosted": "npm run build:react-prod",
    "test:all": "npm run test:objects"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "astro": "^7.0.7"
  },
  "devDependencies": {
    "puppeteer-core": "^23.11.1"
  }
}
