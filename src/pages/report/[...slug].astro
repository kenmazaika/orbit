---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, slugOf } from '../../lib/notes';

export async function getStaticPaths() {
  const reports = (await getCollection('reports')).filter((r) => !r.data.draft);
  return reports.map((entry) => ({ params: { slug: slugOf(entry) }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.summary} page="report">
  <article class="wrap article">
    <a class="back" href="/report/"><span aria-hidden="true">←</span> Latest report</a>
    <div class="article-meta">
      <span>{formatDate(entry.data.pubDate)}</span>
      <span class="sep">·</span>
      <span class="cat-pill">Daily report</span>
    </div>
    <h1 class="article-title">{entry.data.title}</h1>
    {entry.data.summary && <p class="dek">{entry.data.summary}</p>}
    <div class="prose"><Content /></div>
  </article>
</Base>
