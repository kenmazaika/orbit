---
import '@fontsource-variable/literata';
import '@fontsource-variable/inter';
import '@fontsource/ibm-plex-mono';
import '../../styles/global.css';

export function getStaticPaths() {
  return [{ params: { slug: 'obsidian-value' } }];
}
const { slug } = Astro.params;
const title = 'Artifact';
---

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="robots" content="noindex, nofollow, noarchive" />
<meta name="theme-color" content="#FCF9F7" />
<title>{title} · Orbit</title>
<style is:inline>
:root{--ink:#171619;--dim:#6f6878;--line:#e8e1dc;--bg:#FCF9F7;--violet:#6D35C5;--lav:#EDE7F9;
  --mint:#2f9e7f;--red:#a83b3b;--panel:#fff;--serif:'Literata',Georgia,serif;--sans:'Inter',system-ui,sans-serif;
  --mono:'IBM Plex Mono',monospace;--composer:190px;--sheet:66px;--kb:0px}
*{box-sizing:border-box}
html,body{overflow-x:hidden;overflow-x:clip}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased;
  padding-bottom:calc(var(--composer) + var(--sheet) + var(--kb) + env(safe-area-inset-bottom))}
a{color:inherit}
.top{position:sticky;top:0;z-index:40;background:var(--bg);border-bottom:1px solid var(--line)}
.top-in{max-width:760px;margin:0 auto;padding:10px 16px 8px}
.brandrow{display:flex;align-items:center;gap:9px}
.mark{width:26px;height:26px;flex:0 0 auto}
.word{font-family:var(--mono);font-size:.8rem;letter-spacing:.3em;text-transform:uppercase}
.private{margin-left:auto;font-family:var(--mono);font-size:.56rem;letter-spacing:.14em;text-transform:uppercase;
  color:#2f8f74;border:1px solid #b9e3d4;background:#f2fbf7;border-radius:999px;padding:4px 8px}
.crumbs{display:flex;align-items:center;gap:6px;margin-top:9px;font-size:.78rem;color:var(--dim)}
.crumbs a{text-decoration:none;color:var(--dim)}
.crumbs b{font-weight:600;color:var(--ink)}
.toolrow{display:flex;align-items:center;gap:8px;margin-top:8px;flex-wrap:nowrap}
.revpill{display:inline-flex;align-items:center;gap:6px;border:1px solid #d8ccef;background:#f7f3fe;color:var(--violet);
  border-radius:999px;padding:5px 9px;font-size:.74rem;font-weight:600;white-space:nowrap}
.revpill .upd{color:#8b7fa0;font-weight:400}
.iconbtn{width:34px;height:32px;display:grid;place-items:center;border:1px solid var(--line);background:var(--panel);
  border-radius:9px;color:#3d3746;cursor:pointer;padding:0}
.iconbtn svg{width:16px;height:16px}
.select{font-family:inherit;font-size:.74rem;border:1px solid var(--line);background:#fff;border-radius:9px;padding:6px 7px;color:#3d3746}
.spacer{flex:1}
.wrap{max-width:760px;margin:0 auto;padding:22px 16px 8px}
h1{font-family:var(--serif);font-weight:600;font-size:clamp(1.75rem,6vw,2.6rem);line-height:1.1;
  letter-spacing:-.022em;margin:2px 0 12px}
.metarow{display:flex;align-items:center;gap:8px;flex-wrap:wrap;color:var(--dim);font-size:.74rem;margin-bottom:14px}
.chip{font-size:.7rem;border:1px solid var(--line);border-radius:999px;padding:3px 8px;background:#fff;color:#4a4352}
details.front{border:1px solid var(--line);border-radius:11px;background:#fff;margin:0 0 20px;overflow:hidden}
details.front summary{list-style:none;cursor:pointer;padding:9px 12px;font-size:.76rem;color:var(--dim);
  display:flex;align-items:center;gap:7px}
details.front summary::-webkit-details-marker{display:none}
details.front summary svg{width:13px;height:13px;opacity:.6}
.fm{padding:0 12px 12px;border-top:1px solid #f1ece8}
.fm dl{margin:0;display:grid;grid-template-columns:88px 1fr;gap:6px 10px;font-size:.76rem}
.fm dt{font-family:var(--mono);font-size:.62rem;letter-spacing:.08em;text-transform:uppercase;color:#8b8394;padding-top:2px}
.fm dd{margin:0;color:#3d3746;min-width:0;overflow-wrap:anywhere}
.fm .tags{display:flex;flex-wrap:wrap;gap:5px}
.fm .tag{background:#f5f1fb;color:#5b4a7e;border-radius:5px;padding:1px 6px;font-size:.68rem}
.diffbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:0 0 16px;font-size:.78rem;color:var(--dim)}
.modebar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin:0 0 12px}
.modes{display:inline-flex;border:1px solid var(--line);background:#fff;border-radius:999px;padding:3px;gap:2px}
.mode{font:inherit;font-size:.74rem;border:0;background:transparent;color:#5c5566;padding:5px 11px;border-radius:999px;cursor:pointer}
.mode[aria-selected="true"]{background:var(--lav);color:var(--violet);font-weight:600}
.mode:disabled{opacity:.38;cursor:default}
.critbar{display:none;align-items:center;gap:8px;background:var(--lav);border:1px solid #ddcff6;border-radius:11px;
  padding:9px 11px;margin:0 0 16px;font-size:.8rem}
.critbar.show{display:flex}
.critbar b{font-weight:600}
.critsub{margin-left:auto;color:#8b7fa0;font-size:.72rem}
.crit-more{margin:6px 0 14px;padding:8px 11px;border:1px dashed #d9cff0;border-radius:9px;font-size:.76rem;color:#6a5a86}
.blk{position:relative;border-radius:7px;transition:background .15s}
.mhead{position:static;top:auto;margin:12px 0 0;border:1px solid var(--rule);border-radius:10px;overflow:hidden;background:#fff;width:max-content;max-width:100%}
.mhead img{display:block;width:152px;height:86px;object-fit:cover;background:#F2EEEA;cursor:zoom-in}
.mhead.open{width:100%}
.mhead.open img{width:100%;height:auto;aspect-ratio:16/9;cursor:zoom-out}
.mhead figcaption{display:none;align-items:center;gap:8px;padding:8px 10px;font-family:var(--mono);font-size:.58rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.mhead.open figcaption{display:flex}
.mhead .mh-label{color:var(--purple)}
.mh-btn{all:unset;cursor:pointer;font:inherit;font-size:.58rem;letter-spacing:.08em;padding:4px 8px;border:1px solid var(--rule);border-radius:999px;color:var(--text);text-transform:uppercase}
.publication{margin:10px 0 0;font-size:.8rem;color:var(--mint-ink,#1F6B52)}
.publication a{color:inherit;text-decoration:underline}
.wcopts{display:grid;gap:8px;margin:8px 0 10px;padding:10px;border:1px dashed var(--rule);border-radius:10px}
.wcopts[hidden]{display:none}
.wcopts label{display:grid;gap:4px;font-family:var(--mono);font-size:.56rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.wcopts select,.wcopts input[type=text]{font:inherit;font-size:.8rem;padding:7px 9px;border:1px solid var(--rule);border-radius:8px;background:#fff;color:var(--text)}
.hit{background:#FDE68A;box-shadow:0 0 0 2px #FDE68A;border-radius:3px;color:inherit}
.find-disp{font-size:.76rem;color:var(--muted);margin:8px 0 0;padding:6px 9px;background:#F4F1ED;border-radius:7px}
.blk.flag{background:#fdeef1;box-shadow:0 0 0 1px #f6d9e0}
.blk.active{background:#fbdde5}
.chipset{display:inline-flex;gap:4px;margin-left:6px;vertical-align:middle}
.chipmark{font-family:var(--mono);font-size:.58rem;background:var(--violet);color:#fff;border-radius:999px;
  min-width:15px;height:15px;line-height:15px;text-align:center;padding:0 4px;cursor:pointer;border:0}
.find{border:1px solid #e6dcf4;background:#fff;border-radius:11px;margin:6px 0 14px;overflow:hidden}
.find-head{display:flex;align-items:center;gap:8px;width:100%;text-align:left;background:none;border:0;padding:9px 11px;
  font:inherit;cursor:pointer;color:var(--ink)}
.find-num{font-family:var(--mono);font-size:.62rem;background:var(--violet);color:#fff;border-radius:999px;
  width:18px;height:18px;line-height:18px;text-align:center;flex:0 0 auto}
.find-cat{font-size:.82rem;font-weight:600}
.find-chev{margin-left:auto;color:#a49dab;font-size:.8rem}
.find-body{display:none;padding:0 11px 11px;border-top:1px solid #f1ece8}
.find.open .find-body{display:block}
.find-sum{font-family:var(--sans);font-size:.83rem;color:#4a4352;margin:9px 0 0}
.find-exp{font-family:var(--sans);font-size:.8rem;color:#6f6878;line-height:1.5;margin:7px 0 0}
.find-quote{font-family:var(--serif);font-size:.82rem;color:#6f6878;border-left:2px solid #e6dcf4;padding-left:9px;margin:9px 0 0}
.jumplink{display:inline-flex;align-items:center;gap:5px;margin-top:9px;font-size:.74rem;color:var(--violet);
  background:none;border:0;padding:0;cursor:pointer;text-decoration:underline}
.notewrap{margin-top:10px;border:1px solid var(--line);border-radius:9px;background:#fdfcfa;padding:8px 9px}
.notewrap textarea{width:100%;border:0;background:transparent;font-family:var(--sans);font-size:.8rem;
  line-height:1.45;resize:vertical;min-height:34px;outline:none;color:var(--ink)}
.notewrap .nrow{display:flex;align-items:center;gap:8px;margin-top:4px}
.notewrap .nstat{font-size:.68rem;color:#8b8394}
.notewrap button{font:inherit;font-size:.72rem;border:1px solid var(--line);background:#fff;color:#4a4352;
  border-radius:7px;padding:4px 9px;cursor:pointer}
.notewrap button.primary{background:var(--violet);color:#fff;border-color:var(--violet)}
.find-note{font-family:var(--sans);font-size:.78rem;color:#2f8f74;background:#f2fbf7;border:1px solid #cdeee2;
  border-radius:8px;padding:6px 9px;margin-top:9px;white-space:pre-wrap}
.diffbar label{display:inline-flex;gap:7px;align-items:center;cursor:pointer;color:#3d3746}
.diffbar input{accent-color:var(--violet);width:15px;height:15px}
.diffmeta{color:#8b8394;font-size:.72rem}
article{font-family:var(--serif);font-size:1.06rem;line-height:1.76;overflow-wrap:anywhere}
article h1,article h2,article h3{font-family:var(--sans);letter-spacing:-.015em;line-height:1.25;margin:2em 0 .55em}
article h1{font-size:1.45rem}article h2{font-size:1.3rem}article h3{font-size:1.06rem}
article p{margin:0 0 1.05em}
article ul,article ol{margin:0 0 1.1em;padding-left:1.3em}
article li{margin:.3em 0}
article blockquote{margin:1.2em 0;padding:.15em 0 .15em 1em;border-left:3px solid #d9cff0;color:#4b4452}
article pre{background:#f5f0fb;border:1px solid #e6dcf4;border-radius:10px;padding:13px;overflow-x:auto;
  font-family:var(--mono);font-size:.8rem;line-height:1.55;-webkit-overflow-scrolling:touch}
article code{font-family:var(--mono);font-size:.86em;background:#f5f0fb;padding:.1em .28em;border-radius:4px}
article pre code{background:none;padding:0}
article img{max-width:100%;height:auto;border-radius:10px;margin:.9em 0}
article a{color:var(--violet)}
article hr{border:0;border-top:1px solid var(--line);margin:2em 0}
.block{margin:0 0 1em}
.diffwrap{border:1px solid var(--line);border-radius:10px;overflow:hidden;background:#fff;margin:0 0 16px}
.dl{display:flex;gap:8px;padding:1px 8px;font-family:var(--mono);font-size:.755rem;line-height:1.55;
  white-space:pre-wrap;overflow-wrap:anywhere}
.dl .g{flex:0 0 12px;text-align:center;color:#a49dab;user-select:none}
.dl .t{flex:1;min-width:0}
.dl.del{background:#fff1f0}
.dl.del .g{color:#b03a3a}
.dl.ins{background:#eafbf0}
.dl.ins .g{color:#237a61}
.dl.skip{background:#fbf8f5;color:#9a93a3;font-size:.66rem;padding:3px 8px}
.dl.empty{color:#9a93a3;font-size:.72rem;padding:8px}
.sheet{position:fixed;left:0;right:0;bottom:calc(var(--composer) + var(--kb) + env(safe-area-inset-bottom));z-index:38;
  background:var(--panel);border-top:1px solid var(--line);border-radius:16px 16px 0 0;
  box-shadow:0 -10px 30px rgba(23,22,25,.06);max-height:44vh;display:flex;flex-direction:column}
.sheet.collapsed{max-height:66px;overflow:hidden}
.sheet.full{max-height:calc(100vh - var(--composer) - var(--kb) - env(safe-area-inset-bottom) - 8px);max-height:calc(100dvh - var(--composer) - var(--kb) - env(safe-area-inset-bottom) - 8px)}
.tray.min{display:none!important}
.sheet-head{display:flex;align-items:center;gap:8px;padding:15px 14px 9px;cursor:pointer;user-select:none;flex:0 0 auto;
  position:sticky;top:0;z-index:2;background:var(--panel);border-radius:16px 16px 0 0}
.sheet-min{margin-left:auto;flex:0 0 auto;border:1px solid var(--line);background:#fff;border-radius:8px;
  width:30px;height:28px;display:grid;place-items:center;color:#5c5566;cursor:pointer;padding:0}
.sheet-min svg{width:14px;height:14px;transition:transform .18s}
.sheet.collapsed .sheet-min svg{transform:rotate(180deg)}
.grab{width:34px;height:4px;border-radius:2px;background:#e2dbd6;position:absolute;left:50%;top:6px;transform:translateX(-50%)}
.sheet-title{font-size:.76rem;color:var(--dim);padding-top:5px}
.sheet-cta{margin-left:auto;font-size:.72rem;font-weight:600;color:var(--violet);background:var(--lav);
  border:1px solid #ddcff6;border-radius:999px;padding:5px 10px;display:none;cursor:pointer}
.sheet-cta.show{display:inline-block}
.sheet-list{overflow-y:auto;padding:0 14px 12px;min-height:0}
.msg{margin:9px 0;font-size:.86rem;line-height:1.5}
.msg .who{font-family:var(--mono);font-size:.58rem;letter-spacing:.13em;text-transform:uppercase;color:#8b8394}
.msg.user .body{background:#f5f0fb;border-radius:10px;padding:8px 10px;margin-top:3px;white-space:pre-wrap}
.msg.agent .body{margin-top:3px;white-space:pre-wrap}
.msg.system .body{margin-top:3px;color:var(--mint);font-size:.78rem;font-weight:600}
.pending{margin:8px 0;padding:8px 10px;border:1px dashed #d9cff0;border-radius:9px;font-size:.8rem;color:#6a5a86}
.composer{position:fixed;left:0;right:0;bottom:var(--kb);z-index:45;background:var(--bg);border-top:1px solid var(--line);
  padding:8px 14px calc(6px + env(safe-area-inset-bottom))}
.composer-in{max-width:760px;margin:0 auto}
.statusline{display:flex;align-items:center;gap:7px;font-size:.72rem;color:var(--dim);margin:0 2px 6px;min-height:16px}
.actionbar{display:flex;align-items:center;gap:10px;margin:0 2px 8px;padding:8px 10px;border-radius:9px;background:#FBEEEE;border:1px solid #EBC6C6;font-size:.74rem;color:#8A2C2C}
.actionbar.retry{background:#FDF6E7;border-color:#E8D9B5;color:#7A5B12}
.actionbar[hidden]{display:none}
.actionbar-text{flex:1;min-width:0;line-height:1.35}
.actionbar-btn{font:inherit;font-size:.72rem;font-weight:600;padding:5px 10px;border-radius:7px;border:1px solid currentColor;background:transparent;color:inherit;cursor:pointer;white-space:nowrap}
.actionbar-btn.ghost{border-color:transparent;font-weight:400;opacity:.8}
.dot{width:7px;height:7px;border-radius:50%;background:#c9c2cf;flex:0 0 auto}
.dot.working{background:#d9a441;animation:pulse 1.1s infinite}
.dot.ready{background:var(--mint)}
.dot.failed{background:var(--red)}
@keyframes pulse{50%{opacity:.3}}
.tray{display:none;gap:8px;overflow-x:auto;padding:2px 0 8px}
.tray.show{display:flex}
.thumb{position:relative;flex:0 0 auto;width:80px}
.thumb img{width:80px;height:60px;object-fit:cover;border-radius:8px;border:1px solid var(--line);display:block}
.thumb.off img{opacity:.35}
.thumb button{position:absolute;top:-6px;right:-6px;border:0;background:#171619;color:#fff;border-radius:50%;
  width:19px;height:19px;font-size:11px;line-height:19px;cursor:pointer;padding:0}
.thumb small{display:block;font-size:.58rem;color:var(--dim);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.inputrow{display:flex;align-items:flex-end;gap:8px;background:#fff;border:1px solid var(--line);border-radius:20px;
  padding:7px 7px 7px 12px}
.inputrow:focus-within{border-color:#bfa9ea;box-shadow:0 0 0 3px rgba(109,53,197,.08)}
textarea{flex:1;min-height:24px;max-height:30vh;resize:none;border:0;outline:none;background:transparent;
  font-family:inherit;font-size:.95rem;line-height:1.45;padding:5px 0}
.plus{width:32px;height:32px;border-radius:50%;border:1px solid var(--line);background:#fff;color:#5c5566;
  font-size:19px;line-height:28px;cursor:pointer;flex:0 0 auto;padding:0}
.send{width:34px;height:34px;border-radius:50%;border:0;background:var(--violet);color:#fff;display:grid;
  place-items:center;cursor:pointer;flex:0 0 auto}
.send svg{width:16px;height:16px}
.send:disabled{opacity:.4}
.subrow{display:flex;align-items:center;gap:8px;margin-top:6px;padding:0 2px}
.wf{font-family:inherit;font-size:.72rem;border:1px solid var(--line);border-radius:999px;background:#fff;
  color:#5c5566;padding:4px 8px;max-width:150px}
.nav{display:flex;align-items:center;justify-content:space-around;margin-top:8px;padding-top:6px;border-top:1px solid #f1ece8}
.nav a{display:flex;align-items:center;gap:5px;font-size:.66rem;color:#8b8394;text-decoration:none;padding:2px 6px}
.nav a[aria-current]{color:var(--violet);font-weight:600}
.nav svg{width:15px;height:15px}
.wfchip{display:none;font-size:.68rem;color:var(--violet);background:var(--lav);border:1px solid #ddcff6;
  border-radius:999px;padding:3px 8px;white-space:nowrap;max-width:150px;overflow:hidden;text-overflow:ellipsis}
.wfchip.show{display:inline-block}
.toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(var(--composer) + var(--sheet) + var(--kb) + env(safe-area-inset-bottom) + 10px);
  background:#171619;color:#fff;padding:8px 14px;border-radius:999px;font-size:.76rem;z-index:60;opacity:0;
  transition:opacity .18s;pointer-events:none;max-width:88vw;text-align:center}
.toast.show{opacity:1}
</style>
</head>
<body>
<header class="top"><div class="top-in">
  <div class="brandrow">
    <svg class="mark" viewBox="0 0 34 24" fill="none" aria-hidden="true">
      <ellipse cx="17" cy="12" rx="15" ry="6.4" stroke="#6D35C5" stroke-width="1.5" transform="rotate(-18 17 12)"/>
      <ellipse cx="17" cy="12" rx="10.5" ry="10" stroke="#72D7B8" stroke-width="1.3"/>
      <circle cx="17" cy="12" r="2.4" fill="#171619"/>
    </svg>
    <span class="word">Orbit</span>
    <span class="private">Private</span>
  </div>
  <div class="crumbs"><a href="/artifacts/">Artifacts</a><span>/</span><b>Drafts</b></div>
  <div class="toolrow">
    <span class="revpill"><span id="revnum">V2</span><span class="upd" id="revupd">· updated</span></span>
    <span class="spacer"></span>
    <select id="rev-select" class="select" aria-label="Revision"></select>
    <button class="iconbtn" id="download" title="Download Markdown" aria-label="Download Markdown">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 4v11m0 0 4-4m-4 4-4-4M5 19h14"/></svg>
    </button>
    <button class="iconbtn" id="share" title="Share" aria-label="Share">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 15V4m0 0 4 4m-4-4L8 8M5 13v6h14v-6"/></svg>
    </button>
    <button class="iconbtn" id="copy" title="Copy Markdown" aria-label="Copy Markdown">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="8" y="8" width="11" height="11" rx="2"/><path d="M5 15V6a1 1 0 0 1 1-1h9"/></svg>
    </button>
  </div>
</div></header>

<div class="wrap">
  <h1 id="title"></h1>
  <div class="metarow"><span class="chip" id="rev-chip">V2</span><span id="rev-date"></span><span id="wordcount"></span></div>
  <details class="front" id="front">
    <summary><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 6h16M4 12h16M4 18h10"/></svg><span id="fm-summary">Front matter</span></summary>
    <div class="fm"><dl id="fm-list"></dl></div>
  </details>
  <div class="modebar">
    <div class="modes" role="tablist" aria-label="Presentation">
      <button class="mode" data-mode="read" role="tab" aria-selected="true">Read</button>
      <button class="mode" data-mode="diff" role="tab" aria-selected="false">Diff</button>
      <button class="mode" data-mode="critique" role="tab" aria-selected="false" disabled>Critique</button>
    </div>
    <span class="diffmeta" id="mode-hint"></span>
  </div>
  <div class="critbar" id="critbar">
    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="#6D35C5" stroke-width="1.7"><path d="m12 3 2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L12 16.4 6.7 19.2l1.1-5.9L3.5 9.2l5.9-.8z"/></svg>
    <b>Critique · <span id="critcount">0</span> findings</b>
    <span class="critsub" id="critsub">Findings only</span>
  </div>
  <article id="article"><p>Loading…</p></article>
</div>

<section class="sheet collapsed" id="sheet" aria-label="Conversation">
  <div class="sheet-head" id="sheet-head">
    <span class="grab"></span>
    <span class="sheet-title" id="sheet-title">Conversation</span>
